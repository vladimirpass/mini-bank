<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1-create-tables" author="student">
        <!-- Таблица clients -->
        <createTable tableName="clients">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <!-- Добавляем UNIQUE на email -->
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_clients_email"/>
            </column>
        </createTable>

        <!-- Таблица accounts -->
        <createTable tableName="accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="client_id" type="BIGINT">
                <!-- Добавляем FOREIGN KEY на clients -->
                <constraints nullable="false" foreignKeyName="fk_accounts_clients" referencedTableName="clients" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="account_number" type="VARCHAR(34)">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(19,4)" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Таблица transactions -->
        <createTable tableName="transactions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="account_id" type="BIGINT">
                <!-- Добавляем FOREIGN KEY на accounts -->
                <constraints nullable="false" foreignKeyName="fk_transactions_accounts" referencedTableName="accounts" referencedColumnNames="id" deleteCascade="true"/>
            </column>
            <column name="amount" type="DECIMAL(19,4)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Индекс для поиска транзакций счета за период -->
        <createIndex tableName="transactions" indexName="idx_transactions_account_date">
            <column name="account_id"/>
            <column name="transaction_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>